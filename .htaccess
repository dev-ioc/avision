RewriteEngine On
RewriteBase /

# Ne pas rediriger si déjà dans /public
RewriteCond %{REQUEST_URI} !^/public/

# Exclure les fichiers statiques
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|pdf|zip|rar|doc|docx|xls|xlsx|ppt|pptx)$ [NC]

# Rediriger directement vers /public/ (chemin absolu, pas de boucle)
RewriteRule ^(.*)$ /public/$1 [L,R=301]