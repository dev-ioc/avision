[2025-11-20 16:45:58][DEBUG] SQL Update Intervention: UPDATE interventions SET title = :title, client_id = :client_id, site_id = :site_id, room_id = :room_id, technician_id = :technician_id, status_id = :status_id, priority_id = :priority_id, type_id = :type_id, duration = :duration, description = :description, demande_par = :demande_par, contract_id = :contract_id, date_planif = :date_planif, heure_planif = :heure_planif, created_at = :created_at, ref_client = :ref_client, contact_client = :contact_client WHERE id = :id {"params":{":title":"plantage NVX E20 ebl\u00e9e",":client_id":"36",":site_id":"56",":room_id":"161",":technician_id":"3",":status_id":"7",":priority_id":"3",":type_id":"8",":duration":"0.00",":description":"ouverture ticket chez CRESTRON :\r\nBonjour, j'ai un souci avec un encodeur sur IP qui plante r\u00e9guli\u00e8rement depuis la semaine derni\u00e8re.\r\nIl permet l'encodage du signa vid\u00e9o provenant d'une MTR. nous avons d\u00e9j\u00e0 chang\u00e9 le c\u00e2ble RJ45 d'alimentation et le port sur lequel il est branch\u00e9 au switch.\r\nPour le relancer, il faut le d\u00e9connecter du switch puis le rebrancher.\r\nNous n'avions pas rencontr\u00e9 de soucis depuis la livraison de la salle.\r\nAvez-vous d\u00e9j\u00e0 rencontr\u00e9 ce souci sur d'autres produits? j'ai un deuxi\u00e8me E20 et plusieurs NVX D200 dans la baie qui ne pose aucun probl\u00e8me.\r\nPourrait-il \u00eatre d\u00e9fectueux?\r\nci-joint ses infos:\r\nEncoder MTR \r\nCrestron\r\nDM-NVX-E20\r\nVideo\/contr\u00f4le\r\n2510JBH11400\r\n7.1.5259.00084\r\n7.1.5259.00064\r\nC4:42:68:6F:A3:63\r\n",":demande_par":"",":contract_id":"179",":date_planif":"2025-11-20",":heure_planif":null,":created_at":"2025-11-20 16:38:00",":ref_client":"",":contact_client":"cyril.lebraud@caissedesdepots.fr",":id":"176"},"updates":["title = :title","client_id = :client_id","site_id = :site_id","room_id = :room_id","technician_id = :technician_id","status_id = :status_id","priority_id = :priority_id"