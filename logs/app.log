[2025-10-15 12:31:58][DEBUG] SQL Update Intervention: UPDATE interventions SET title = :title, client_id = :client_id, site_id = :site_id, room_id = :room_id, technician_id = :technician_id, status_id = :status_id, priority_id = :priority_id, type_id = :type_id, duration = :duration, description = :description, demande_par = :demande_par, contract_id = :contract_id, date_planif = :date_planif, heure_planif = :heure_planif, created_at = :created_at, ref_client = :ref_client, contact_client = :contact_client WHERE id = :id {"params":{":title":"MBA70 - Confidence Moniteur - Demande  d'intervention \u00e0 distance afin de r\u00e9tablir l\u2019assignation auto",":client_id":"5",":site_id":"8",":room_id":"53",":technician_id":"5",":status_id":"4",":priority_id":"2",":type_id":"8",":duration":"2.00",":description":"Ticket : INC0926615\r\n \r\nNous avons constat\u00e9 une perte de signal sur le vid\u00e9oprojecteur et le confidence monitor de l\u2019amphith\u00e9\u00e2tre MBA70.\r\n \r\nNous avons red\u00e9marr\u00e9 \u00e0 plusieurs reprises le processeur ainsi que la matrice Crestron DM.\r\nLe signal a \u00e9t\u00e9 r\u00e9tabli sur le vid\u00e9oprojecteur, mais le confidence monitor restait inactif, sans m\u00eame la possibilit\u00e9 de le contr\u00f4ler (ON\/OFF).\r\nApr\u00e8s avoir red\u00e9marr\u00e9 le r\u00e9cepteur RX Crestron situ\u00e9 derri\u00e8re l\u2019\u00e9cran, nous avons retrouv\u00e9 le contr\u00f4le ON\/OFF, mais aucune source n\u2019\u00e9tait d\u00e9tect\u00e9e.\r\nAucun probl\u00e8me pour l\u2019assignement sources pour le vid\u00e9oprojecteur.\r\nNous avons d\u00fb assigner la source manuellement depuis la fa\u00e7ade de la matrice DM.\r\n \r\nSerait-il possible d\u2019intervenir \u00e0 distance afin de r\u00e9tablir l\u2019assignation automatique de la source depuis la dalle tactile (communication entre le processeur et la matrice) ?\r\n \r\nInformation compl\u00e9mentaire : le confidence monitor est connect\u00e9 sur la sortie 2 de la matrice DM.\r\n",":demande_par":"Vincent DE MARCHI",":contract_id":"168",":date_planif":"2025-10-15",":heure_planif":"10:20",":created_at":"2025-10-15 09:57:00",":ref_client":"INC0926615",":contact_client":"onsite.supportfbl@insead.edu",":id":"141"},"updates":["title = :title","client_id = :client_id","site_id = :site_id","room_id = :room_id","technician_id = :technician_id","status_id = :status_id","priority_id = :priority_id","type_id = :type_id","duration = :duration","description = :description","demande_par = :demande_par","contract_id = :contract_id","date_planif = :date_planif","heure_planif = :heure_planif","created_at = :created_at","ref_client = :ref_client","contact_client = :contact_client"]}
