[2025-10-17 12:19:31][DEBUG] SQL Update Intervention: UPDATE interventions SET title = :title, client_id = :client_id, site_id = :site_id, room_id = :room_id, technician_id = :technician_id, status_id = :status_id, priority_id = :priority_id, type_id = :type_id, duration = :duration, description = :description, demande_par = :demande_par, contract_id = :contract_id, date_planif = :date_planif, heure_planif = :heure_planif, created_at = :created_at, ref_client = :ref_client, contact_client = :contact_client WHERE id = :id {"params":{":title":"Probl\u00e8me d\u2019affichage des cam\u00e9ras Stage et Audience \u2013 Flat 3 - INC0926705",":client_id":"5",":site_id":"8",":room_id":"54",":technician_id":"5",":status_id":"1",":priority_id":"2",":type_id":"8",":duration":"3.00",":description":"Ticket : INC0926705\r\nNous sommes actuellement confront\u00e9s \u00e0 un probl\u00e8me concernant la cam\u00e9ra Stage et la cam\u00e9ra Audience en Flat 3.\r\n\r\nNous avons proc\u00e9d\u00e9 \u00e0 plusieurs red\u00e9marrages complets de l\u2019ensemble des \u00e9quipements (encoders, decoders, cam\u00e9ras, switch, desktop, cartes de capture, etc.), mais le probl\u00e8me persiste.\r\n\r\nSympt\u00f4mes observ\u00e9s :\r\n\r\nLes cam\u00e9ras Stage et Audience affichent une image noire dans Zoom via les entr\u00e9es cam\u00e9ras sur le desktop.\r\nLa cam\u00e9ra Audience est bien visible en local sur le vid\u00e9oprojecteur, les \u00e9crans lat\u00e9raux et le moniteur de confidence mais pas dans le zoom.\r\nLa cam\u00e9ra Stage, quant \u00e0 elle, n\u2019affiche aucune image, ni en local ni dans Zoom.\r\nOn arrive pas \u00e0 se connecter sur l\u2019encoder stage Cam via L\u2019IP : http:\/\/10.67.16.56\/\r\nLes deux cam\u00e9ras sont bien d\u00e9tect\u00e9es sur le r\u00e9seau.\r\nLors de nos tests, aucun signal vid\u00e9o n\u2019a \u00e9t\u00e9 d\u00e9tect\u00e9 entre les deux d\u00e9codeurs \u201cPC Cameras\u201d et les cartes de capture inogeni.",":demande_par":"Vincent DE MARCHI",":contract_id":"168",":date_planif":"2025-10-16",":heure_planif":"14:01:00",":created_at":"2025-10-15 15:16:00",":ref_client":"AV & Go live Specialist, FBL Onsite Support Team",":contact_client":"onsite.supportfbl@insead.edu",":id":"142"},"updates":["title = :title","client_id = :client_id","site_id = :site_id","room_id = :room_id","technician_id = :technician_id","status_id = :status_id","priority_id = :priority_id","type_id = :type_id","duration = :duration","description = :description","demande_par = :demande_par","contract_id = :contract_id","date_planif = :date_planif","heure_planif = :heure_planif","created_at = :created_at","ref_client = :ref_client","contact_client = :contact_client"]}
